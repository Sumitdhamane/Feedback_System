@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Home";
}

<style>
    .hero-section {
        background: linear-gradient(135deg, #007bff, #6610f2);
        padding: 80px 20px;
        color: white;
        border-radius: 12px;
        margin-bottom: 40px;
        box-shadow: 0px 4px 18px rgba(0, 0, 0, 0.2);
    }

    .feature-card {
        transition: 0.3s;
    }

    .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.2);
    }
</style>

<!-- HERO SECTION -->
<div class="hero-section text-center">
    <h1 class="display-4 fw-bold mb-3">Welcome to the Feedback System</h1>
    <p class="lead">A simple and powerful platform where students can share feedback and admins can view detailed reports.</p>

    <a href="/Student/Login" class="btn btn-light btn-lg mt-3">
        Get Started →
    </a>
</div>

<!-- FEATURES -->
<div class="container">
    <div class="row text-center">

        <div class="col-md-4 mb-3">
            <div class="card feature-card p-3 shadow-sm">
                <h4 class="fw-bold">Student Feedback</h4>
                <p>Students can easily give feedback to teachers with rating & comments.</p>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card feature-card p-3 shadow-sm">
                <h4 class="fw-bold">Admin Dashboard</h4>
                <p>Admins can view all reports, analyze performance, & download PDFs.</p>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card feature-card p-3 shadow-sm">
                <h4 class="fw-bold">PDF Reports</h4>
                <p>Generate and download clean PDF reports for teachers with one click.</p>
            </div>
        </div>

    </div>
</div>
