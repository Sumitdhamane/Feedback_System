@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Success";
}

<style>
    .success-card {
        max-width: 450px;
        margin: auto;
        margin-top: 80px;
        padding: 40px 30px;
        background: #ffffff;
        border-radius: 15px;
        text-align: center;
        box-shadow: 0px 6px 20px rgba(0, 0, 0, 0.1);
        animation: fadeIn 0.5s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: scale(0.95);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .success-icon {
        font-size: 60px;
        color: #28a745;
        margin-bottom: 15px;
        animation: pop 0.6s ease-out;
    }

    @@keyframes pop {
        0% {
            transform: scale(0);
        }

        80% {
            transform: scale(1.1);
        }

        100% {
            transform: scale(1);
        }
    }

    .btn-custom {
        margin-top: 20px;
        padding: 10px;
        width: 100%;
        font-size: 16px;
        font-weight: 600;
    }
</style>

<div class="success-card">
    <div class="success-icon">✔️</div>

    <h2 class="fw-bold">Thank You!</h2>
    <p class="text-muted">Your feedback has been submitted successfully.</p>

    <a href="/Student/Dashboard" class="btn btn-success btn-custom">
        Back to Dashboard
    </a>
</div>
